{
  "name": "@local/dsh-japanese",
  "version": "0.2.2",
  "description": "DeepSeek Harnessの日本語言語パックと日本語フォント",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "upstream.json",
    "LICENSE.DeepSeek"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "external": [
        "react",
        "react/jsx-runtime",
        "react-dom"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.1-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-brand": ">=0.2.1-alpha.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    },
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "pack:plugin": "node scripts/pack.mjs",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "typecheck": "tsc --noEmit",
    "test:native": "node scripts/native-check.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "clsx": "^2.1.1",
    "esbuild": "0.28.2",
    "immer": "^10.2.0",
    "playwright": "^1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "use-sync-external-store": "^1.7.0",
    "zustand": "^5.0.15",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-alpha.2",
    "semver": "^7.8.5",
    "@types/semver": "^7.8.0",
    "@types/node": "^22.0.0"
  }
}
